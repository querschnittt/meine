<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Der Switch">
<meta name="theme-color" content="#14140F">
<title>Der Switch</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');

:root{
  --bg:#14140F;
  --card:#1D1D16;
  --card2:#232319;
  --border:#2C2C22;
  --text:#F2F0E6;
  --muted:#9C9A8C;
  --amber:#E8A33D;
  --amber-dim:#4A3A1C;
  --flame:#D9622B;
  --flame-dim:#3A2318;
  --teal:#5B8C7B;
  --teal-dim:#22322B;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Inter',sans-serif;
  min-height:100vh;
  padding:0 0 60px 0;
}
.wrap{max-width:640px; margin:0 auto; padding:0 20px;}

header{
  padding:calc(36px + env(safe-area-inset-top)) 20px 24px 20px;
  border-bottom:1px solid var(--border);
  margin-bottom:24px;
  position:relative;
  overflow:hidden;
}
header::before{
  content:"";
  position:absolute;
  top:-40%; right:-10%;
  width:280px; height:280px;
  background:radial-gradient(circle, var(--amber-dim) 0%, transparent 70%);
  opacity:0.5;
  pointer-events:none;
}
.eyebrow{
  font-family:'Space Mono',monospace;
  font-size:11px;
  letter-spacing:0.18em;
  color:var(--muted);
  text-transform:uppercase;
  margin-bottom:10px;
}
h1{
  font-family:'Big Shoulders Display',sans-serif;
  font-weight:800;
  font-size:52px;
  letter-spacing:0.01em;
  line-height:0.95;
  text-transform:uppercase;
}
h1 span{color:var(--amber);}
.date-line{
  margin-top:10px;
  font-size:14px;
  color:var(--muted);
}

.streak-box{
  display:flex;
  align-items:center;
  gap:18px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:4px;
  padding:18px 22px;
  margin:20px auto 28px auto;
}
.flame{font-size:34px; filter:drop-shadow(0 0 8px rgba(217,98,43,0.5));}
.streak-num{
  font-family:'Big Shoulders Display',sans-serif;
  font-weight:800;
  font-size:44px;
  color:var(--flame);
  line-height:1;
  min-width:60px;
  font-variant-numeric:tabular-nums;
}
.streak-label{
  font-size:12px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--muted);
}

.gauge-wrap{margin-bottom:28px;}
.gauge-label{
  display:flex; justify-content:space-between; align-items:baseline;
  font-family:'Space Mono',monospace;
  font-size:12px; letter-spacing:0.06em; color:var(--muted);
  margin-bottom:8px;
}
.gauge-label b{color:var(--amber); font-size:14px;}
.gauge-track{
  height:10px;
  background:var(--card2);
  border:1px solid var(--border);
  border-radius:2px;
  overflow:hidden;
}
.gauge-fill{
  height:100%;
  background:linear-gradient(90deg, var(--flame), var(--amber));
  transition:width 0.4s ease;
  width:0%;
}

.section{margin-bottom:28px;}
.section-head{display:flex; align-items:center; gap:10px; margin-bottom:12px;}
.section-num{
  font-family:'Space Mono',monospace;
  font-size:12px;
  color:var(--bg);
  background:var(--amber);
  width:22px; height:22px;
  display:flex; align-items:center; justify-content:center;
  border-radius:3px;
  flex-shrink:0;
}
.section-title{
  font-family:'Big Shoulders Display',sans-serif;
  font-weight:700;
  font-size:22px;
  text-transform:uppercase;
  letter-spacing:0.02em;
}
.section-title small{
  font-family:'Inter',sans-serif;
  font-weight:400;
  text-transform:none;
  color:var(--muted);
  font-size:13px;
  letter-spacing:0;
  margin-left:6px;
}

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:4px;
  overflow:hidden;
}

.row{
  display:flex;
  align-items:center;
  gap:14px;
  padding:14px 16px;
  border-bottom:1px solid var(--border);
  cursor:pointer;
  transition:background 0.15s ease;
  user-select:none;
}
.row:last-child{border-bottom:none;}
.row:hover{background:var(--card2);}
.row.done .row-text{color:var(--muted); text-decoration:line-through; text-decoration-color:var(--border);}

.switch{
  width:44px; height:24px;
  background:var(--card2);
  border:1px solid var(--border);
  border-radius:12px;
  position:relative;
  flex-shrink:0;
  transition:background 0.25s ease, border-color 0.25s ease;
}
.switch::after{
  content:"";
  position:absolute;
  top:2px; left:2px;
  width:18px; height:18px;
  background:var(--muted);
  border-radius:50%;
  transition:transform 0.25s ease, background 0.25s ease;
}
.row.done .switch{background:var(--amber-dim); border-color:var(--amber);}
.row.done .switch::after{transform:translateX(20px); background:var(--amber);}

.row-body{flex:1;}
.row-text{font-size:14.5px; font-weight:500;}
.row-sub{font-size:12px; color:var(--muted); margin-top:2px;}

.fast-banner{
  padding:16px;
  border-bottom:1px solid var(--border);
  display:flex; align-items:center; gap:14px;
}
.fast-banner.big{background:var(--flame-dim);}
.fast-banner.normal{background:var(--teal-dim);}
.fast-mode{
  font-family:'Big Shoulders Display',sans-serif;
  font-weight:800;
  font-size:30px;
  line-height:1;
  min-width:78px;
}
.fast-banner.big .fast-mode{color:var(--flame);}
.fast-banner.normal .fast-mode{color:var(--teal);}
.fast-window{font-size:14px; font-weight:600; margin-bottom:3px;}
.fast-detail{font-size:12px; color:var(--muted); line-height:1.45;}

.weekstrip{
  display:flex;
  border-bottom:1px solid var(--border);
  background:var(--card2);
}
.wd{
  flex:1;
  text-align:center;
  padding:10px 0;
  font-family:'Space Mono',monospace;
  font-size:11px;
  color:var(--muted);
  border-right:1px solid var(--border);
}
.wd:last-child{border-right:none;}
.wd.today{color:var(--amber);}
.wd .dot{
  display:block;
  margin:5px auto 0 auto;
  width:6px; height:6px; border-radius:50%;
  background:var(--border);
}
.wd.fastday .dot{background:var(--flame);}
.wd.eatday .dot{background:var(--teal);}

.note{
  font-size:12px;
  color:var(--muted);
  background:var(--card2);
  border:1px solid var(--border);
  border-left:3px solid var(--amber);
  padding:10px 14px;
  border-radius:3px;
  margin-top:10px;
  line-height:1.5;
}

.footer{margin-top:36px; text-align:center;}
.reset-btn{
  background:none; border:1px solid var(--border);
  color:var(--muted); font-size:12px;
  padding:8px 16px; border-radius:3px; cursor:pointer;
  font-family:'Space Mono',monospace;
}
.reset-btn:hover{border-color:var(--flame); color:var(--flame);}

.loading{
  text-align:center; padding:60px 20px; color:var(--muted);
  font-family:'Space Mono',monospace; font-size:13px;
}

.complete-banner{
  background:linear-gradient(90deg, var(--flame-dim), var(--amber-dim));
  border:1px solid var(--amber);
  border-radius:4px;
  padding:16px;
  text-align:center;
  margin-bottom:24px;
  font-family:'Big Shoulders Display',sans-serif;
  font-size:18px;
  letter-spacing:0.02em;
  text-transform:uppercase;
  color:var(--amber);
  display:none;
}
.complete-banner.show{display:block;}

@media(max-width:480px){ h1{font-size:40px;} }
</style>
</head>
<body>
<div class="wrap" id="app">
  <div class="loading">Lade deinen Switch …</div>
</div>

<script>
(function(){

function pad(n){return n.toString().padStart(2,'0');}
function todayKey(d){
  d = d || new Date();
  return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
}
function dateLabel(d){
  const days=['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];
  const months=['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
  return days[d.getDay()]+', '+d.getDate()+'. '+months[d.getMonth()];
}
function daysBetween(a,b){
  const da=new Date(a+'T00:00:00'), db=new Date(b+'T00:00:00');
  return Math.round((db-da)/86400000);
}

// Wochenplan: 0=So ... 6=Sa. Montag (1) = 24h-Fasten, sonst 8:16.
function fastPlan(dow){
  if(dow === 1){
    return {
      mode:'24H',
      big:true,
      window:'Ganztägiges Fasten',
      detail:'Letzte Mahlzeit gestern (So) 20:00 Uhr · nächste Mahlzeit heute (Mo) 20:00 Uhr.',
      check:'24-Stunden-Fasten bis 20:00 Uhr eingehalten'
    };
  }
  return {
    mode:'8:16',
    big:false,
    window:'Essensfenster 12:00 – 20:00 Uhr',
    detail:'8 Std. essen, 16 Std. fasten. Außerhalb des Fensters nichts außer Wasser/Tee.',
    check:'Fastenfenster heute eingehalten'
  };
}

const DRINK_ITEMS = [
  {id:'wasser', text:'Großes Glas Wasser (500ml) direkt nach dem Aufwachen', sub:'Vor Kaffee, Essen oder Handy'},
  {id:'flohsamen', text:'Spike-Flattener: 1 EL Flohsamenschalen oder Chiasamen in Wasser', sub:'10–15 Min vor der ersten Mahlzeit einwirken lassen'},
  {id:'matcha', text:'Matcha oder schwarzer Kaffee, ungesüßt', sub:'Zur Mahlzeit'},
  {id:'essig', text:'Apfelessig (1–2 EL), verdünnt, mit Strohhalm', sub:'Nur zusammen mit Essen, nie auf leeren Magen'},
  {id:'koffein', text:'Koffein-Stopp, mind. 10 Std. vor dem Schlafen', sub:'Schützt Schlaf & Cortisol'}
];

let state = {
  dateKey: todayKey(),
  drink: {},
  fastDone: false
};
let streak = {count:0, lastCompleteDate:null};
let loaded = false;

function loadAll(){
  try{
    const raw = localStorage.getItem('vs_day:'+state.dateKey);
    if(raw){
      const saved = JSON.parse(raw);
      state = Object.assign(state, saved, {dateKey: state.dateKey});
    }
  }catch(e){}
  try{
    const raw = localStorage.getItem('vs_streak');
    if(raw){ streak = JSON.parse(raw); }
  }catch(e){}
  loaded = true;
  render();
}

function saveDay(){
  try{ localStorage.setItem('vs_day:'+state.dateKey, JSON.stringify(state)); }
  catch(e){ console.error('Speichern fehlgeschlagen', e); }
}
function saveStreak(){
  try{ localStorage.setItem('vs_streak', JSON.stringify(streak)); }catch(e){}
}

function allRequiredDone(){
  const drinkAllDone = DRINK_ITEMS.every(it => state.drink[it.id]);
  return drinkAllDone && state.fastDone;
}
function countDone(){
  let total = DRINK_ITEMS.length + 1;
  let done = DRINK_ITEMS.filter(it=>state.drink[it.id]).length;
  if(state.fastDone) done++;
  return {done, total};
}

function evaluateStreak(){
  if(allRequiredDone()){
    if(streak.lastCompleteDate !== state.dateKey){
      const prev = streak.lastCompleteDate;
      if(prev && daysBetween(prev, state.dateKey) === 1){ streak.count += 1; }
      else { streak.count = 1; }
      streak.lastCompleteDate = state.dateKey;
      saveStreak();
    }
  } else {
    if(streak.lastCompleteDate === state.dateKey){
      streak.count = Math.max(0, streak.count - 1);
      streak.lastCompleteDate = null;
      saveStreak();
    }
  }
}

function afterChange(){
  saveDay();
  evaluateStreak();
  render();
}
function toggleDrink(id){ state.drink[id] = !state.drink[id]; afterChange(); }
function toggleFast(){ state.fastDone = !state.fastDone; afterChange(); }

function resetToday(){
  if(!confirm('Heutigen Tag wirklich zurücksetzen?')) return;
  state.drink = {};
  state.fastDone = false;
  saveDay();
  evaluateStreak();
  render();
}

function render(){
  if(!loaded){
    document.getElementById('app').innerHTML = '<div class="loading">Lade deinen Switch …</div>';
    return;
  }
  const dObj = new Date(state.dateKey+'T00:00:00');
  const dow = dObj.getDay();
  const plan = fastPlan(dow);
  const {done, total} = countDone();
  const pct = Math.round((done/total)*100);
  const allDone = allRequiredDone();

  const drinkRows = DRINK_ITEMS.map(it => `
    <div class="row ${state.drink[it.id]?'done':''}" data-drink="${it.id}">
      <div class="switch"></div>
      <div class="row-body">
        <div class="row-text">${it.text}</div>
        <div class="row-sub">${it.sub}</div>
      </div>
    </div>
  `).join('');

  const labels=['S','M','D','M','D','F','S']; // So Mo Di Mi Do Fr Sa
  const weekstrip = labels.map((l,i)=>{
    const isFast = (i===1);
    const cls = isFast ? 'fastday' : 'eatday';
    const today = (i===dow) ? 'today' : '';
    return `<div class="wd ${cls} ${today}">${l}<span class="dot"></span></div>`;
  }).join('');

  document.getElementById('app').innerHTML = `
    <header>
      <div class="eyebrow">Sculpt by Science · Free Guide</div>
      <h1>Der<br><span>Switch</span></h1>
      <div class="date-line">${dateLabel(dObj)}</div>
    </header>

    <div class="streak-box">
      <div class="flame">🔥</div>
      <div>
        <div class="streak-num">${streak.count}</div>
        <div class="streak-label">Tage in Folge komplett</div>
      </div>
    </div>

    <div class="complete-banner ${allDone?'show':''}">Switch ist heute auf ON — alles erledigt.</div>

    <div class="gauge-wrap">
      <div class="gauge-label"><span>Heute erledigt</span><b>${done} / ${total}</b></div>
      <div class="gauge-track"><div class="gauge-fill" style="width:${pct}%"></div></div>
    </div>

    <div class="section">
      <div class="section-head">
        <div class="section-num">01</div>
        <div class="section-title">Trinkstack</div>
      </div>
      <div class="card">${drinkRows}</div>
    </div>

    <div class="section">
      <div class="section-head">
        <div class="section-num">02</div>
        <div class="section-title">Intervallfasten <small>Wochenplan</small></div>
      </div>
      <div class="card">
        <div class="fast-banner ${plan.big?'big':'normal'}">
          <div class="fast-mode">${plan.mode}</div>
          <div>
            <div class="fast-window">${plan.window}</div>
            <div class="fast-detail">${plan.detail}</div>
          </div>
        </div>
        <div class="weekstrip">${weekstrip}</div>
        <div class="row ${state.fastDone?'done':''}" data-action="fast">
          <div class="switch"></div>
          <div class="row-body">
            <div class="row-text">${plan.check}</div>
            <div class="row-sub">${plan.big?'Montag ist der 24-Std.-Fastentag':'Dienstag bis Sonntag: 8:16'}</div>
          </div>
        </div>
      </div>
      <div class="note">Wochenrhythmus: Di–So im 8:16-Fenster (12–20 Uhr), Montag 24 Std. fasten — letzte Mahlzeit Sonntag 20:00, nächste Mahlzeit Montag 20:00. Der Balken zeigt oben den heutigen Wochentag (🔥 = Fastentag).</div>
    </div>

    <div class="footer">
      <button class="reset-btn" id="btn-reset">Heutigen Tag zurücksetzen</button>
    </div>
  `;

  document.querySelectorAll('[data-drink]').forEach(el=>{
    el.addEventListener('click', ()=>toggleDrink(el.dataset.drink));
  });
  document.querySelector('[data-action="fast"]').addEventListener('click', toggleFast);
  document.getElementById('btn-reset').addEventListener('click', resetToday);
}

loadAll();
})();
</script>
</body>
</html>
